# Copy to `.env` and drop your key in. Never committed, never sent to the browser —
# the key stays in the Node process and only the proxy at /api/ai talks to Anthropic.
#
# Anthropic keys look like `sk-ant-...` and run to roughly 108 characters. A key
# with any other prefix belongs to a different service and api.anthropic.com will
# reject it with a 401.
ANTHROPIC_API_KEY=

# If your key belongs to a service that proxies Anthropic rather than to
# Anthropic itself, point the SDK at that service's endpoint here.
# FORGE_AI_BASE_URL=https://…

# ── Model ────────────────────────────────────────────────────────
FORGE_MODEL=claude-opus-5
FORGE_EFFORT=high          # low | medium | high — medium is a good deal cheaper
FORGE_PORT=5273

# ── Spend limits ─────────────────────────────────────────────────
# Enforced in server/aiRouter.js, server-side, because the browser is exactly
# where a limit could be edited away. A refused call reports which limit it hit
# and when it lifts. Counters are in memory and reset when the server restarts.
FORGE_AI_MAX_TOKENS=3000        # ceiling on a single reply
FORGE_AI_MIN_INTERVAL_MS=2000   # minimum gap between calls
FORGE_AI_HOURLY_CAP=25          # calls per rolling hour
FORGE_AI_DAILY_CAP=120          # calls per rolling day
FORGE_AI_MAX_TURNS=3            # tool-use round trips per request — the real
                                # spend multiplier, since one prompt can chain
                                # into several billed calls
